<!doctype html>
<html class="no-js" lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1">
        
        <link rel="shortcut icon" type="image/x-icon" href="/system/production/assets/454754/original/progressive__icon--v2.png">
        <link rel="stylesheet" href="https://dhbhdrzi4tiry.cloudfront.net/cdn/sites/foundation.min.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

        <!--iCims / Altru-->
        <link rel="stylesheet" href="/system/production/assets/420263/original/video-widget.min.css{% asset_seed %}">

        {% careersites_required_head_tags %}

        {% include '/_config__variables' %}

        <!--START SEO META-->
        {% if cb_is_home_page == 'true' %}
            {{ 'careers-home' | pages_with_tag | assign_to: 'careers_home' }}
            <!--Setting meta content for Careers Home page-->
            {% capture seo_to_index %}true{% endcapture %}
            {% capture meta_title %}Search For Insurance Jobs and Apply | {{ cb_company_name }} Careers{% endcapture %}
            {% capture meta_description %}{{ careers_home[0].meta_description }}{% endcapture %}
            {% capture meta_keywords %}{{ careers_home[0].meta_keywords }}{% endcapture %}

        {% elsif cb_is_category_page == 'true' %}
            <!--Setting meta content for Category pages-->
            {% capture seo_to_index %}true{% endcapture %}
            {% capture meta_title %}{{ category_pages[0].title | html_safe }} | {{ cb_company_name }} Careers{% endcapture %}
            {% capture meta_description %}{% if category_pages[0].meta_description != blank %}{{ category_pages[0].meta_description }}{% else %}{% meta_description_unescape %}{% endif %}{% endcapture %}
            {% capture meta_keywords %}{% if category_pages[0].meta_keywords != blank %}{{ category_pages[0].meta_keywords }}{% else %}{% meta_keywords %}{% endif %}{% endcapture %}

        {% elsif cb_is_job_search == 'true' %}
            {% if selected_facets.size == 1 %}
                {% capture seo_to_index %}true{% endcapture %}
                {% capture meta_title %}{{ selected_facets[0]["label"] | html_escape }} Career{% if jobs.total_entries > 1 %}s{% endif %} | {{ cb_company_name }} Careers{% endcapture %}
                {% capture meta_description %}{% if jobs.total_entries > 0 %}Search {{ jobs.total_entries }} {% endif %}{{ selected_facets[0]["label"] | html_escape }} Career{% if jobs.total_entries > 1 %}s{% endif %} available at {{ cb_company_name }}.{% endcapture %}
                {% capture meta_keywords %}{% meta_keywords %}{% endcapture %}
            <!--Setting meta content for Saved Jobs page-->
            {% elsif params['saved_jobs'] == '1' %}
                {% capture seo_to_index %}false{% endcapture %}
                {% capture meta_title %}Saved Jobs | {{ cb_company_name }} Careers{% endcapture %}
                {% capture meta_description %}{% endcapture %}
                {% capture meta_keywords %}{% endcapture %}
            <!--Setting meta content for Job Search Results pages-->
            {% else %}
                {% if request_fullpath contains '?' and request_fullpath contains '=' %}
                    {% capture seo_to_index %}false{% endcapture %}
                {% elsif selected_facets.size > 1 %}
                    {% capture seo_to_index %}false{% endcapture %}
                {% else %}
                    {% capture seo_to_index %}true{% endcapture %}
                {% endif %}
                {% capture meta_title %}Job Search Results | {{ cb_company_name }} Careers{% endcapture %}
                {% capture meta_description %}{% if jobs.total_entries > 0 %}Search {{ jobs.total_entries }} {% endif %}Career{% if jobs.total_entries > 1 %}s{% endif %} available at {{ cb_company_name }}.{% endcapture %}
                {% capture meta_keywords %}{% meta_keywords %}{% endcapture %}
            {% endif %}

        {% elsif job %}
            <!--Setting meta content for Job Details pages-->
            {% capture job_location %}
            {% if job.location.city != blank %}
                {{ job.location.city }}{% if job.location.state_prov_short != blank or job.location.country != blank %},{% endif %}
            {% endif %}
            {% if job.location.state_prov_short != blank %}
                {% capture job_location_state_prov_short_no_digit %}{{ job.location.state_prov_short | replace_global_regex: "[\d]", ":::" }}{% endcapture %}
                {% if job_location_state_prov_short_no_digit contains ':::' %}
                    {{ job.location.state_prov }}{% if job.location.country != blank %},{% endif %}
                {% else %}
                    {{ job.location.state_prov_short }}{% if job.location.country != blank %},{% endif %}
                {% endif %}
            {% endif %}
            {% if job.location.country != blank %}{{ job.location.country }}{% endif %}
            {% endcapture %}
            {% capture seo_to_index %}{{ job.active? }}{% endcapture %}
            {% capture meta_title %}{{ job.title }} in {{ job_location }} | {{ cb_company_name }} Careers{% endcapture %}
            {% capture meta_description %}{{ job.title }} in {{ job_location }}{% endcapture %}
            {% capture meta_keywords %}{% meta_keywords %}{% endcapture %}

        {% elsif page %}
            <!--Setting meta content for content pages-->
            {% if page.tag_list contains 'no-index' %}
                {% capture seo_to_index %}false{% endcapture %}
            {% else %}
                {% capture seo_to_index %}true{% endcapture %}
            {% endif %}
            {% capture page_seo_title %}{% careersites_required_title %}{% endcapture %}
            {% capture meta_title %}{% if page_seo_title != blank %}{{ page_seo_title }}{% else %}{{ page.title | html_safe }} | Progressive Careers{% endif %}{% endcapture %}
            {% capture meta_description %}{% meta_description_unescape %}{% endcapture %}
            {% capture meta_keywords %}{% meta_keywords %}{% endcapture %}

        {% elsif post %}
            <!--Setting meta content for blog posts-->
            {% capture seo_to_index %}true{% endcapture %}
            {% capture page_seo_title %}{% careersites_required_title %}{% endcapture %}
            {% capture meta_title %}{% if page_seo_title != blank %}{{ page_seo_title }}{% else %}{{ post.title | html_safe }} | Progressive Careers{% endif %}{% endcapture %}
            {% capture meta_description %}{% meta_description_unescape %}{% endcapture %}
            {% capture meta_keywords %}{% meta_keywords %}{% endcapture %}

        {% else %}
            {% capture seo_to_index %}true{% endcapture %}
            {% capture meta_title %}{% careersites_required_title %}{% endcapture %}
            {% capture meta_description %}{% meta_description_unescape %}{% endcapture %}
            {% capture meta_keywords %}{% meta_keywords %}{% endcapture %}

        {% endif %}

        {% if root_url contains 'internal' %}
            <!--Setting meta content for non-indexable sites-->
            {% capture seo_to_index %}false{% endcapture %}
            {% capture meta_description %}{% endcapture %}
            {% capture meta_keywords %}{% endcapture %}
        {% endif %}

        <title>{{ meta_title }}</title>

        {% if seo_to_index == 'true' %}
            {% if root_url contains 'preview' or root_url contains '-dev' %}
                <meta name="robots" content="noindex, nofollow">
            {% else %}
                {% if job %}
                    <meta name="robots" content="index, nofollow">
                {% else %}
                    <meta name="robots" content="index, follow">
                {% endif %}
            {% endif %}
        {% else %}
            <meta name="robots" content="noindex, nofollow">
        {% endif %}

        {% capture current_url_with_current_locale_permalink %}{{ request_host_with_port }}{{ locale_permalink }}{% endcapture %}
        {% capture current_url %}https://{{ request_host_with_port }}{{ request_path }}{% endcapture %}

        {% if available_locales.total_entries > 0 %}
            {% capture canonical_url %}{{ current_url | replace: current_url_with_current_locale_permalink,request_host_with_port }}{% endcapture %}
        {% else %}
            {% capture canonical_url %}{{ current_url }}{% endcapture %}
        {% endif %}

        {% comment %}Ensure that there's a trailing slash no matter what!{% endcomment %}
        {% assign canonical_url_last_char = canonical_url | slice: -1 %}
        {% if canonical_url_last_char != "/" %}
            {% capture canonical_url %}{{ canonical_url }}/{% endcapture %}
        {% endif %}
        <link rel="canonical" href="{{ canonical_url }}" />

        {% for locale in available_locales %}
            {% capture current_url_with_locale_permalink %}{{ request_host_with_port }}/{{ locale.locale }}{% endcapture %}
            {% capture locale_canonical_url %}{{ canonical_url | replace: request_host_with_port,current_url_with_locale_permalink }}{% endcapture %}
            <link href="{{ locale_canonical_url }}" hreflang="{{ locale.locale }}" rel="alternate" type="text/html"/>
        {% endfor %}

        {% if meta_description != blank %}
            <meta name="description" content="{{ meta_description }}">
        {% endif %}
        {% comment %}
        {% if meta_keywords != blank %}
            <meta name="keywords" content="{{ meta_keywords }}">
        {% endif %}
        Removed because meta keywords are outdated, irrelevant and has no impact on search engine rankings; and could even hurt SEO
        {% endcomment %}
        <!--END SEO META-->

        <meta property="og:title" content="{{ meta_title }}" />
        <meta property="og:type" content="website" />
        <meta property="og:image" content="/system/production/assets/454755/original/progressive__social-share--v2.jpg" />
        <meta property="og:url" content="{{ root_url }}{{ request_fullpath | remove_first: '/' }}" />
        {% if meta_description != blank %}<meta property="og:description" content="{{ meta_description }}" />{% endif %}
        <meta property="og:locale" content="{% if current_locale.locale != blank %}{{ current_locale.locale }}{% else %}en{% endif %}" />
        <meta property="og:image:alt" content="{{ cb_company_name }}">
        <meta property="og:site_name" content="{{ career_site.name }}" />

        {{ 'careers-home' | pages_with_tag | assign_to: 'careers_home' }}
        {% if cb_is_home_page == 'true' %}
            {% if careers_home[0].images.size == 1 %}{% capture web_image_url %}{{ careers_home[0].images[0].url }}{% endcapture %}{% endif %}
            {% capture web_name %}{{ careers_home[0].title | html_safe }}{% endcapture %}

        {% elsif cb_is_category_page == 'true' %}
            {% if category_pages[0].images.size == 1 %}{% capture web_image_url %}{{ category_pages[0].images[0].url }}{% endcapture %}{% endif %}
            {% capture web_name %}{{ category_pages[0].title | html_safe }}{% endcapture %}

        {% elsif cb_is_job_search == 'true' %}
            {% if selected_facets.size == 1 %}
                {% capture web_name %}{{ selected_facets[0]["label"] | html_escape }} Careers{% endcapture %}
            {% elsif params['saved_jobs'] == '1' %}
                {% capture web_name %}Saved Jobs{% endcapture %}
            {% else %}
                {% capture web_name %}Job Search Results{% endcapture %}
            {% endif %}

        {% elsif job %}
            {% capture web_name %}{{ job.title }}{% endcapture %}

        {% elsif page %}
            {% if page.images.size == 1 %}{% capture web_image_url %}{{ page.images[0].url }}{% endcapture %}{% endif %}
            {% capture web_name %}{{ page.title | html_safe }}{% endcapture %}

        {% elsif post %}
            {% if post.images.size > 0 %}{% capture web_image_url %}{{ post.images[0].url }}{% endcapture %}{% endif %}
            {% capture web_name %}{{ post.title | html_safe }}{% endcapture %}

        {% endif %}

        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "WebPage",
            "name": "{{ web_name }}",
            "description": "{{ meta_description }}",
            "url": "{{ root_url }}{{ request_path| remove_first: '/' }}/"{% if web_image_url != blank %},
            "image": "{{ web_image_url }}"{% endif %}
        }
        </script>

        {% comment %}START Capturing Breadcrumb List + Schema{% endcomment %}
        {% capture  breadcrumb_list %}{% endcapture %}
        {% capture  breadcrumb_list_schema %}{% endcapture %}
        {% if page and page.tag_list contains 'child-to-' %}
            {{ page | assign_to: 'page_object' }}

            {% for i in (1..employer.pages.size) %}
                {% comment %}{{forloop.index}} : {{ page_object.title | html_safe }}<br />{% endcomment %}
                {% if page_object.tag_list contains 'child-to-' %}
                    {% for tag in page_object.tags %}
                        {% if tag contains 'child-to' %}
                            {% capture parent_page_permalink %}{{ tag | remove_first: 'child-to-' }}{% endcapture %}

                            {{ 'has-child' | pages_with_tag | assign_to: 'parent_pages' }}
                            {% for parent_page in parent_pages %}
                                {% if parent_page.permalink == parent_page_permalink %}
                                    {% capture parent_page_title %}{{ parent_page.title | html_safe }}{% endcapture %}
                                    {% assign page_object = parent_page %}
                                    {% break %}
                                {% endif %}
                            {% endfor %}

                            {% capture parent_page_permalink_link %} &nbsp;&nbsp;&#8226;&nbsp;&nbsp; <a href="/pages/{{ parent_page_permalink }}/">{{ parent_page_title }}</a>{% endcapture %}
                            {% capture  breadcrumb_list %}{{ breadcrumb_list | prepend: parent_page_permalink_link }}{% endcapture %}

                            {% capture parent_page_schema %}
                            |||,{
                                "@type": "ListItem",
                                "position": [FORLOOPINDEX],
                                "name": "{{ parent_page_title }}",
                                "item": "{{ root_url | replace: '.com/','.com' }}/pages/{{ parent_page_permalink }}"
                            }
                            {% endcapture %}
                            {% capture  breadcrumb_list_schema %}{{ breadcrumb_list_schema | prepend: parent_page_schema }}{% endcapture %}

                            {% break %}
                        {% endif %}
                    {% endfor %}

                {% else %}
                    {% assign page_object = '' %}
                    {% break %}

                {% endif %}

                {% capture total_parent_pages %}{{ forloop.index }}{% endcapture %}
            {% endfor %}
        {% endif %}
        {% comment %}END Capturing Breadcrumb List + Schema{% endcomment %}

        {% comment %}Outputting Breadcrumb List Schema{% endcomment %}
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": [

        {% if cb_is_home_page == 'true' %}
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Careers"
            }
        {% else %}
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Careers",
                "item": "{% if cb_site_type == 'internal' %}{{ cb_url_careers_internal }}{% else %}{{ cb_url_careers_external }}{% endif %}"
            }
        {% endif %}

        {% unless cb_is_home_page == 'true' %}
            {% capture breadcrumb_list_schema_sorted %}{% endcapture %}

            {{ breadcrumb_list_schema | split: '|||' | assign_to: 'breadcrumb_list_schema_items' }}
            {% for breadcrumb_list_schema_item in breadcrumb_list_schema_items %}
                {% capture breadcrumb_list_schema_sorted %}
                {{ breadcrumb_list_schema_sorted }}
                {{ breadcrumb_list_schema_item | replace: '[FORLOOPINDEX]',forloop.index }}
                {% endcapture %}
            {% endfor %}

            {{ breadcrumb_list_schema_sorted }}

            {% if cb_is_job_search %}
                ,{
                    "@type": "ListItem",
                    "position": 2,
                    "name": "Job Openings"
                }

            {% elsif job %}
                ,{
                    "@type": "ListItem",
                    "position": 2,
                    "name": "Job Openings",
                    "item": "{{ root_url | replace: '.com/','.com' }}/search/jobs"
                }
                ,{
                    "@type": "ListItem",
                    "position": 3,
                    "name": "{{ job.title | html_safe }}"
                }

            {% elsif post %}
                ,{
                    "@type": "ListItem",
                    "position": 2,
                    "name": "Life at Progressive",
                    "item": "{{ cb_url_careers_external }}/pages/{{ cb_life_permalink }}"
                }
                ,{
                    "@type": "ListItem",
                    "position": 3,
                    "name": "{{ post.title | html_safe }}"
                }

            {% else %}
                ,{
                    "@type": "ListItem",
                    "position": {% if page.tag_list contains 'child-to-' %}{{ total_parent_pages | plus: 2 }}{% else %}2{% endif %},
                    "name": "{{ page.title | html_safe }}"
                }
                
            {% endif %}
        {% endunless %}
            ]
        }
        </script>

        {% comment %}Prod only code here{% endcomment %}
        {% capture site_scripts_head %}/_site-{{ cb_site_type }}__scripts--head{% endcapture %}
        {% include site_scripts_head %}
    </head>
    <body id="{{ template.permalink }}" class="scroll{% if request_fullpath contains '/search' %} has-search{% endif %}">
        {% comment %}Prod only code here{% endcomment %}
        {% capture site_scripts_body %}/_site-{{ cb_site_type }}__scripts--body{% endcapture %}
        {% include site_scripts_body %}

        {% comment %}
        Pf 1/8: Progressive wants to remove the Talent Networks from all sites for now. They will add them back in a later Phase but not necessarily the same way.
        <div class="hide">
            {% capture returnurl %}return_url\":\"http:\\\\\\\\\\\\\\\\{{career_site.domain}}/\"{% endcapture %}
            {% capture tn %}
              {{ "Join our Talent Network" | link_to_talent_network: "talent-network-main-js", "talent-network-main-js" }}
            {% endcapture %}
            {{ tn | replace: 'return_url\":null', returnurl }}
        </div>
        {% endcomment %}

        <div class="hide" id="general-referral-main-js">
            {% if cb_is_dev == 'true' %}
                {{ "General Referral" | link_to_launcher, launcher_key: "315ae3a1-5941-423a-b641-58865dea35f2" }}
            {% else %}
                {{ "General Referral" | link_to_launcher, launcher_key: "516cf9f1-2f67-4c88-aaec-9a0175427580" }}
            {% endif %}
        </div>

        <div class="hide" id="employee-survey-main-js">
            {% if cb_is_dev == 'true' %}
                {{ "Employee Survey" | link_to_launcher, launcher_key: "bb47a18d-3887-49a6-b96b-26dfe17dea8a" }}
            {% else %}
                {{ "Employee Survey" | link_to_launcher, launcher_key: "e3b06331-5eaa-4bf8-8126-353816ae2766" }}
            {% endif %}
        </div>

        <div class="preloader-wrapper preloader-wrapper--page">
            <div class="preloader preloader--page">
                <div class="page-loading hide-for-print" role="alert" aria-labelledby="page-loading">
                    <div class="show-for-sr"><label id="page-loading">Page is loading</label></div>
                </div>
            </div>
        </div>
        <div class="preloader-loaded">
            <div class="page-loaded hide-for-print" role="alert" aria-labelledby="page-loaded">
                <div class="show-for-sr"><label id="page-loaded">Page has loaded</label></div>
            </div>
        </div>

        <div class="width-detector"></div>

        <div class="saved-jobs-alert-wrapper full-height full-width hide-for-print" role="alert">
            <div class="saved-jobs-alert background-white">
                <div class="saved-jobs-alert__check background-1 color-white padded-medium">
                    <i class="fa fa-circle-check" aria-hidden="true"></i>
                </div>
                <div class="saved-jobs-alert__message background-white color-1 padded-medium"></div>
            </div><!--close .saved-jobs-alert-->
        </div><!--close .saved-jobs-alert-wrapper-->

        <div class="page-container fadeIn">

            <div class="body-inner">
                <div class="marker-1"></div>
                <div class="marker-2"></div>
                <div class="marker-3"></div>

                <div class="relative-container" style="z-index: 99999;">
                    <a class="skip-main hide-for-print" href="#main" rel="nofollow">Skip to Main Content</a>
                </div>

                {{ 'header-message' | pages_with_tag | assign_to: 'header_message' }}
                {% if cb_is_home_page == 'true' and header_message.size > 0 %}
                <div class="top-message-js hide relative-container text-center" data-module="info-bar">
                    <div class="row">
                        <div class="column {{ cb_classes_column_wide }}">
                            {{ header_message[0].content }}
                        </div>
                    </div>
                    <a hef="javascript:void(0);" class="top-message-close-js"><span class="show-for-sr">close</span></a>
                </div>
                {% endif %}
                
                <!--START Header-->
                <div class="top-wrapper relative-container">
                    <div class="header-anchor js"></div>
                    <div class="header-outer" data-module="header">
                        <header>
                            <div class="row row--bigger">
                                <div class="hide-for-print columns small-3 header__menu-mobile non-menu hide-for-large header__column">
                                    {% if cb_site_type == 'loa' %}
                                        &nbsp;
                                    {% else %}
                                        <div class="padded-medium">
                                            <a href="javascript:void(0);" aria-expanded="false" class="header__menu-mobile-button" rel="nofollow" data-tracking-label="menu-open">Menu</a>
                                        </div>
                                    {% endif %}
                                </div>

                                <div class="columns small-6 large-2 xlarge-3 header__logo non-menu header__column">
                                    <a data-tracking-label="logo" href="{% if cb_site_type == 'internal' %}{{ cb_url_careers_internal }}{% else %}https://www.progressive.com/{% endif %}" class="padded-medium"><img src="/system/production/assets/454753/original/progressive__logo.svg{% asset_seed %}" alt="{{ cb_company_name }}" loading="lazy" /></a>
                                </div>

                                <div class="hide-for-print columns large-8 xlarge-6 header__menu" aria-hidden="true">
                                    {% if cb_site_type == 'loa' %}
                                        &nbsp;
                                    {% else %}
                                        <nav class="header__menu-nav" tabindex="-1">
                                            <div class="hide-for-large header__menu-copy">Menu</div>
                                            <ul class="clearfix">
                                                {% if cb_site_type == 'internal' %}
                                                    <li class="not-a-parent"><a data-tracking-label="am-i-ready" href="/pages/am-i-ready">Am I Ready?</a></li>
                                                    <li class="not-a-parent"><a data-tracking-label="preparing-for-your-interview" href="/pages/preparing-for-your-interview">Preparing for Your Interview</a></li>
                                                    <li class="not-a-parent"><a data-tracking-label="faqs" href="/pages/faqs">FAQs </a></li>
                                                    <li class="not-a-parent"><a data-tracking-label="erp" href="/pages/erp">ERP</a></li>
                                                    <li class="not-a-parent"><a data-tracking-label="my-employee-referrals" href="{{ 'en' | candidate_portal_url }}" rel="nofollow">My Employee Referrals</a></li>

