{%- endcomment -%}
{% page_required_header %}

{% include '/_config__variables' %}

{% unless root_url contains 'agency' or cb_site_type == 'internal' %}
    {% if job.active? and cb_is_referral_page != 'true' %}
        <script type="application/ld+json">
            {
                "@context" : "http://schema.org/",
                "@type" : "JobPosting",
                "title" : "{{ job.title | escape_javascript }}",
                "description" : "{{ job.description | escape_javascript | replace: "\'","'" | replace: "\$","$" }}",
                "identifier": {
                    "@type": "PropertyValue",
                    "name": "{{ cb_company_name }}",
                    "value": "{{ job.external_id }}"
                },
                "hiringOrganization" : {
                    "@type" : "Organization",
                    "name" : "{{ cb_company_name }}",
                    "logo" : "{{ root_url }}system/production/assets/454754/original/progressive__icon--v2.png"
                },
                "jobLocation" : {
                    "@type" : "Place",
                    "address" : {
                        "@type" : "PostalAddress",
                        "streetAddress" : "{{ job.location.street | escape_javascript }}",
                        "addressLocality" : "{{ job.location.city | escape_javascript }}",
                        "addressRegion" : "{{ job.location.state_prov | escape_javascript }}",
                        "postalCode" : "{{ job.location.postal_code | escape_javascript }}",
                        "addressCountry": "{{ job.location.country | escape_javascript }}"
                    }
                },
                "datePosted" : "{{ job.updated_at | date: "%Y-%m-%d" }}",
                "directApply": true
            }
        </script>
    {% endif %}
{% endunless %}

{% if cb_is_job_details == 'false' %}
    {% unless job.active? %}
        {% redirect_temporary '/search/jobs?ns_inactive_job=1' %}
    {% endunless %}
{% endif %}

<span id="apply-top" class="js hide">
    {% if job.active? %}
        {% if agency %}
            {{ job | link_to_apply:"Submit Candidate", agency }}
        {% else %}
            {{ job | link_to_apply:"Apply Now" }}
        {% endif %}
    {% endif %}
</span>

{% if cb_is_job_details == 'true' %}
    <div id="refer-top" class="js hide">
        {{ job | link_to_referral:'Refer a Friend' }}
    </div>
{% endif %}

{% capture job_detail_data %}
{% if cb_site_type == 'internal' or cb_site_type == 'loa' %}
    <p>
        <strong>Job Number:</strong> {{ job.cfm25 }}{% comment %}cfm25 is JobDisplayID{% endcomment %}
        {% if job.cfdisplay_SalaryGrade != blank %}
            <br />
            <a class="tooltip-link" href="javascript:void(0);">
                <strong>Salary Grade:</strong>
                {{ job.cfdisplay_SalaryGrade }}
                <span class="tooltip-content" aria-label="disclosure" aria-describedby="tip-salary-grade"><span id="tip-salary-grade">Progressive job level; a range indicates differing levels may be considered</span></span>
            </a>
        {% endif %}

        {% if job.cfdisplay_geo != blank %}<br /><strong>Geo:</strong> {{ job.cfdisplay_geo }}{% endif %}
        {% if job.cfdisplay_GainshareTargetPercentage != blank %}<br /><strong>Gainshare Target Percentage:</strong> {{ job.cfdisplay_GainshareTargetPercentage }}{% endif %}

        {% if job.cfm5 != blank %}
            <br />
            <a class="tooltip-link" href="javascript:void(0);">
                <strong>Category:</strong>
                {{ job.cfm5 }}
                <span class="tooltip-content" aria-label="disclosure" aria-describedby="tip-category"><span id="tip-category">Main category to use when searching for common job groupings</span></span>
            </a>
        {% endif %}{% comment %}cfm5 is 'category' custom field{% endcomment %}

        {% if job.cfdisplay_jobdescriptionlibrarycategory != blank %}
            <br />
            <a class="tooltip-link" href="javascript:void(0);">
                <strong>Job Description Library Category:</strong>
                {{ job.cfdisplay_jobdescriptionlibrarycategory }}
                <span class="tooltip-content" aria-label="disclosure" aria-describedby="tip-job-description-library-category"><span id="tip-job-description-library-category">Job Category listed in the HRexpress Job Description Library</span></span>
            </a>
        {% endif %}

        {% capture job_location_state_prov_short_no_digit %}{{ job.location.state_prov_short | replace_global_regex: "[\d]", ":::" }}{% endcapture %}
        {% if job_location_state_prov_short_no_digit contains ':::' %}
            {% capture job_state_prov %}{{ job.location.state_prov }}{% endcapture %}
        {% else %}
            {% capture job_state_prov %}{{ job.location.state_prov_short }}{% endcapture %}
        {% endif %}
        <br /><strong>Location:</strong>
        {{ job.location.city }}{% if job.location.city != blank and job_state_prov != blank %},{% endif %}
        {% if job_state_prov != blank %}{{ job_state_prov }}{% endif %}
        {% if job.location.city == blank and job_state_prov == blank %}
            {{ job.location.country }}
        {% endif %}

        {% if job.remote_work_label != blank %}<br /><strong>Remote Type:</strong> {{ job.remote_work_label }}{% endif %}
        {% if job.cfdisplay_EmployeeStatus != blank %}<br /><strong>Employee Status:</strong> {{ job.cfdisplay_EmployeeStatus }}{% endif %}

        {% if job.cfdisplay_Schedule != blank %}<br /><strong>Schedule:</strong> {{ job.cfdisplay_Schedule }}{% endif %}
        {% if job.cfdisplay_OvertimeStatus != blank %}<br /><strong>Overtime Status:</strong> {{ job.cfdisplay_OvertimeStatus }}{% endif %}
        {% if job.cfdisplay_QualifiedCandidate != blank %}<br /><strong>Qualified Candidate:</strong> {{ job.cfdisplay_QualifiedCandidate }}{% endif %}
        {% if job.cfdisplay_HiringManagerFN != blank or job.cfdisplay_HiringManagerLN != blank %}<br /><strong>Hiring Manager:</strong> {{ job.cfdisplay_HiringManagerFN }} {{ job.cfdisplay_HiringManagerLN }}{% endif %}
        {% if job.cfdisplay_RecruiterFN != blank or job.cfdisplay_RecruiterLN != blank %}<br /><strong>Recruiter:</strong> {{ job.cfdisplay_RecruiterFN }} {{ job.cfdisplay_RecruiterLN }}{% endif %}
    </p>
{% else %}
    <p>
        <strong>Job Number:</strong> {{ job.cfm25 }}{% comment %}cfm25 is JobDisplayID{% endcomment %}
        {% if job.cfm5 != blank %}<br /><strong>Category:</strong> {{ job.cfm5 }}{% endif %}{% comment %}cfm5 is 'category' custom field{% endcomment %}

        {% capture job_location_state_prov_short_no_digit %}{{ job.location.state_prov_short | replace_global_regex: "[\d]", ":::" }}{% endcapture %}
        {% if job_location_state_prov_short_no_digit contains ':::' %}
            {% capture job_state_prov %}{{ job.location.state_prov }}{% endcapture %}
        {% else %}
            {% capture job_state_prov %}{{ job.location.state_prov_short }}{% endcapture %}
        {% endif %}
        <br /><strong>Location:</strong>
        {{ job.location.city }}{% if job.location.city != blank and job_state_prov != blank %},{% endif %}
        {% if job_state_prov != blank %}{{ job_state_prov }}{% endif %}
        {% if job.location.city == blank and job_state_prov == blank %}
            {{ job.location.country }}
        {% endif %}

        {% if job.remote_work_label != blank %}<br /><strong>Remote Type:</strong> {{ job.remote_work_label }}{% endif %}
        {% if job.cfm4 != blank %}<br /><strong>Job Level:</strong> {{ job.cfm4 }}{% endif %}
    </p>
{% endif %}
{% endcapture %}

<div id="header-wrapper-fixed-bottom"></div>

<div id="job-details">
    <div class="job-details-preloader-js preloader preloader--job">
        <div class="facet-job-loading hide-for-print" role="alert" aria-labelledby="facet-job-loading">
            <div class="show-for-sr"><label id="facet-jobs-loading">Loading job</label></div>
        </div>
    </div>

    <div class="job-details-inner-js">
        <div class="job-details__heading padded-v-small hide">
            <div class="row">
                <div class="columns large-5 small-text-center large-text-left padded-v-small job-details__heading-back">
                    <a href="/search/jobs/" class="js" id="back-to-search" rel="nofollow">Back to Search Results</a>
                </div>
                <div class="columns large-7 small-text-center padded-v-small large-text-right job-details__prev-next-opportunity">
                    <a href="#" class="hide" id="job-details__prev-link" rel="nofollow">Previous Opportunity</a>
                    <a href="#" class="hide" id="job-details__next-link" rel="nofollow">Next Opportunity</a>
                </div><!--close .job-details__prev-next-opportunity-->
            </div>
        </div>

        <div class="padded-v-xlarge">
            <div class="row space-large">
                <div class="columns {{ cb_classes_column_wide }}">
                    <h1 id="main" tabindex="-1" class="space-large">
                    {% if cb_site_type == 'internal' or cb_site_type == 'loa' %}
                        {{ job.cfdisplay_internaljobtitle | html_safe }}
                    {% else %}
                        {{ job.title | html_safe }}
                    {% endif %}
                    </h1>

                    <div class="hide-for-large">
                        {{ job_detail_data }}
                    </div>

                    {% unless job.active? %}
                        <p>This job posting is no longer active.</p>
                    {% endunless %}
                    {% if notice %}
                        <p>{{ notice }}</p>
                    {% endif %}
                </div><!--close .column-->
            </div><!--close .row-->

            <div class="row">
                <div class="column {{ cb_classes_column_wide }}">
                    <div class="row">
                        <div class="columns large-9 job-details__main">
                            <div class="row">
                                <div class="columns large-6">
                                    {% if cb_show_referral_elements == 'true' and cb_show_referral_share == 'true' %}
                                        <div class="padded-v-medium space-small">
                                            <div class="cs_share_container cs_cfix clearfix">
                                                <span class="cs_share_text">Share:</span>
                                                <span class="cs_share_email"></span>
                                                <span class="cs_share_twitter"></span>
                                                <span class="cs_share_facebook"></span>
                                                <span class="cs_share_linkedin"></span>
                                            </div>
                                        </div>

                                        {% if cb_is_job_details == 'true' %}
                                            <div class="social-share-url branded-search space-small" style="box-shadow: none;">
                                                <input type="text" width="50" value="{{ job.default_career_site_referral_url }}" id="social-share-url__input-1-js">
                                                <a href="javascript:void(0);" class="social-share-url__copy-js" rel="nofollow">Copy</a>
                                                {% comment %}Copy to clipboard only works if the input is visible! If it needs to be hidden, position the input off-screen{% endcomment %}
                                            </div>
                                        {% endif %}

                                    {% else %}
                                        &nbsp;

                                    {% endif %}
                                </div>
                                <div class="columns large-6 large-text-right space-medium">
                                    {% if job.active? %}
                                        {% if agency %}
                                            <a href="javascript:void(0);" class="apply-bottom js branded-button-1 space-small" style="min-width: 272px;">Submit Candidate</a>
                                        {% else %}
                                            {% if hide_apply_button != 'true' %}
                                                <!-- <a href="javascript:void(0);" class="apply-bottom js branded-button-1 space-small" style="min-width: 272px;">Apply Now</a> -->
                                                <button class="apply-bottom js branded-button-1 space-small" style="min-width: 272px;">Apply Now</button>
                                            {% endif %}
                                        {% endif %}
                                    {% endif %}

                                    {% comment %}
                                    &nbsp;&nbsp;
                                    <a href="javascript:savejob();" class="branded-button-1 space-small hide save-job" rel="nofollow">Save Job</a>
                                    <a href="javascript:savejob();" class="branded-button-1 space-small hide job-saved" rel="nofollow">Saved</a>
                                    {% endcomment %}

                                    {% if cb_is_job_details == 'true' %}
                                        <br />
                                        {% if cb_show_referral_elements == 'true' %}
                                            <a href="javascript:void(0);" class="refer-bottom js branded-button-1 space-small" style="min-width: 272px;">Submit a Referral</a>
                                        {% endif %}

                                        <div class="space-medium">
                                            {% if job.referral_incentive_amount != blank or job.referral_incentive_description != blank %}
                                                <h2 class="heading-3 space-small">
                                                    Referral Award:
                                                    {% if job.referral_incentive_amount != blank %}
                                                        {% if job.referral_incentive_currency == 'USD' or job.referral_incentive_currency == 'CAD' %}${% elsif job.referral_incentive_currency == 'EUR' %}€{% elsif job.referral_incentive_currency == 'GBP' %}£{% endif %}{{ job.referral_incentive_amount }} ({{ job.referral_incentive_currency }})
                                                    {% endif %}
                                                    {% if job.referral_incentive_description != blank %}{{ job.referral_incentive_description }}{% endif %}
                                                </h2>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>

                            <section class="page-section">
                                <div class="space-large">
                                    {% if cb_site_type == 'internal' or cb_site_type == 'loa' %}
                                        {{ job.cfdisplay_AdditionalJobSpecifications}}
                                        {{ job.cfdisplay_descriptioninternal }}

                                    {% else %}
                                        {{ job.description }}

                                    {% endif %}
                                </div>

                                <div class="row space-large">
                                    <div class="columns large-6">
                                        {% if cb_show_referral_elements == 'true' and cb_show_referral_share == 'true' %}
                                            <div class="padded-v-medium space-small">
                                                <div class="cs_share_container cs_cfix clearfix">
                                                    <span class="cs_share_text">Share:</span>
                                                    <span class="cs_share_email"></span>
                                                    <span class="cs_share_twitter"></span>
                                                    <span class="cs_share_facebook"></span>
                                                    <span class="cs_share_linkedin"></span>
                                                    {% if cb_is_job_details == 'true' %}
                                                        <script type="text/javascript">CareerSite.Share.init({url: "{{job.default_career_site_referral_url}}"})</script>
                                                    {% else %}
                                                        <script type="text/javascript">talemetry.share();</script>
                                                    {% endif %}
                                                </div>
                                            </div>

                                            {% if cb_is_job_details == 'true' %}
                                                <div class="social-share-url branded-search space-small" style="box-shadow: none;">
                                                    <input type="text" width="50" value="{{ job.default_career_site_referral_url }}" id="social-share-url__input-2-js">
                                                    <a href="javascript:void(0);" class="social-share-url__copy-js" rel="nofollow">Copy</a>
                                                    {% comment %}Copy to clipboard only works if the input is visible! If it needs to be hidden, position the input off-screen{% endcomment %}
                                                </div>
                                            {% endif %}

                                        {% else %}
                                            &nbsp;

                                        {% endif %}
                                    </div>
                                    <div class="columns large-6 large-text-right">
                                        {% if job.active? %}
                                            {% if agency %}
                                                <a href="javascript:void(0);" class="apply-bottom js branded-button-1" style="min-width: 272px;">Submit Candidate</a>
                                            {% else %}
                                                {% if hide_apply_button != 'true' %}
                                                    <!-- <a href="javascript:void(0);" class="apply-bottom js branded-button-1" style="min-width: 272px;">Apply Now</a> -->
                                                    <button class="apply-bottom js branded-button-1 space-small" style="min-width: 272px;">Apply Now</button>
                                                {% endif %}
                                            {% endif %}
                                        {% endif %}&nbsp;
                                    </div>
                                </div>
                            </section>
                        </div><!--close .job-details__main-->

                        <div class="columns large-3 job-details__sidebar">
                            <div class="show-for-large space-large">
                                {{ job_detail_data }}
                            </div>

                            {% comment %}
                            DS: 1/15 Removing CultureHQ videos - customer wanted to change the original code they provided, but have not provided the new code! But they want to move the sites in PROD by 1/17.
                            {% if job.cfdisplay_DescriptionVideoID != blank %}
                            <div class="space-large">
                                {% if cb_site_type == 'loa' %}
                                    <div data-chq-id="{{ job.cfdisplay_DescriptionVideoID }}"></div><div id="main"></div><script type="text/javascript">+function (s, t) { (y = document.createElement("script")).type = "text/javascript"; y.src = "https://culturehq-assets.s3.us-west-2.amazonaws.com/single-story-widget_1723572085.js"; y.onload = function () { CHQ(s, t) }; document.getElementsByTagName("head")[0].appendChild(y); }("#main", "null")</script>
                                {% else %}
                                    <div data-chq-id="{{ job.cfdisplay_DescriptionVideoID }}"></div><div id="chq_main"></div><script type="text/javascript">+function (s, t, q) { (y = document.createElement("script")).type = "text/javascript"; y.src = "https://culturehq-assets.s3.us-west-2.amazonaws.com/single-story-widget_1723572085.js"; y.onload = function () { CHQ(s, t, q) }; document.getElementsByTagName("head")[0].appendChild(y); }("#chq_main", "null", {"org": 122 })</script>
                                {% endif %}
                            </div>
                            {% endif %}
                            {% endcomment %}

                            <div class="job-details__similar-jobs page-section similar-jobs-element-js hide space-medium">
                                <h2 class="heading-3 space-small">Similar Jobs</h2>
                                <div class="similar-jobs--job-js"></div>
                                {% capture similar_jobs_query %}{% if job.cfm5 != blank %}cfm5={{ job.cfm5 }}{% endif %}{% if job.cfm4 != blank %}{% if job.cfm5 != blank %}&{% endif %}cfm4={{ job.cfm4 }}{% endif %}{% endcapture %}{% comment %}cfm5 is 'category' custom field, cfm4 is 'joblevel' custom field{% endcomment %}
                                {% capture similar_jobs_url %}{{ root_url }}search/jobs/?{{ similar_jobs_query }}&per_page=4&ns_job_id={{ job.id }}&ns_similar_jobs=1{% endcapture %}

                                {% if similar_jobs_query != blank %}
                                <script>
                                    // Ajax load similar jobs
                                    ajaxloadjobs('{{ similar_jobs_url }}',function() {
                                        loadjob();
                                    });

                                    // Job Details page: Previous and Next Opportunity buttons
                                    $('.job-details__similar-jobs-item').each(function() {
                                        if ($(this).hasClass('{{ job.external_id }}')) {
                                            $(this).addClass('hide');

                                            var prev_link = $(this).prev().find('a').attr('href');
                                            var next_link = $(this).next().find('a').attr('href');

                                            if (typeof prev_link != 'undefined') {
                                                $('a#job-details__prev-link').attr('href',prev_link).removeClass('hide');
                                            }
                                            if (typeof next_link != 'undefined') {
                                                $('a#job-details__next-link').attr('href',next_link).removeClass('hide');
                                            }
                                        }
                                    });
                                </script>
                                {% endif %}
                            </div><!--close .job-details__similar-jobs-->

                            {% if visitor.recent_jobs.total_entries > 0 and cb_site_type != 'internal' %}{% comment %}Customer wants to use a custom field for the Job Title, but custom fields are not supported for Personalization{% endcomment %}
                                <div class="padded-v-small space-small">
                                    <div class="visitor-item-wrapper space-medium">
                                        <h3 class="heading-4 space-small">Recently Viewed Jobs</h3>
                                        {% for job_data in visitor.recent_jobs limit: 5 %}
                                            <div class="visitor-item space-small"><a href="{{job_data.url}}" rel="nofollow">{{ job_data.title }}</a></div>
                                        {% endfor %}
                                    </div><!--close .visitor-item-wrapper-->
                                </div><!--close .branded-box-->
                            {% else %}
                                {% comment %}
                                <div class="space-small"><span class="branded-button-outer branded-button-1-outer branded-button-wide-outer">{{ "Personalize your experience" | link_to_social_login }}</span></div>
                                <!-- <span class="small-text"><a href="{{career_site.enable_tracking_url}}" rel="nofollow">Click here to enable personalized experience</a></span> -->
                                {% endcomment %}
                            {% endif %}
                        </div><!--close .job-details__sidebar-->
                    </div>
                </div>
            </div><!--close .column-->
        </div><!--close .row-->
    </div><!--close .job-details-inner-js-->

</div><!--close #job-details-->

{% comment %}
<script>
    // Save Jobs functionality
    var is_job_saved = false;
    var job_index;
    var job_saved_message;
    var c_jobs_temp = localStorage.getItem('c_jobs') ? JSON.parse(localStorage.getItem('c_jobs')) : [];
    var saved_jobs_query;

    // Detecting if job has been saved
    if (c_jobs_temp.indexOf('{{ job.external_id }}') >= 0) {
        $('.job-saved').removeClass('hide');
        is_job_saved = true;
        job_index = c_jobs_temp.indexOf('{{ job.external_id }}');
        $('.saved-jobs-alert__check').toggleClass('removed');
    }
    else {
        is_job_saved = false;
        $('.save-job').removeClass('hide');
    }

    function savejob() {
        {% if params['savejob'] == blank %}
            {% capture job_url_save %}{{ job.url }}{% if request_fullpath contains '?' %}&{% else %}?{% endif %}savejob=1{% endcapture %}
            window.location.replace('{{ job_url_save }}'); 
        {% endif %}
    }
    {% if params['savejob'] == '1' %}
        var job_item;
        if (is_job_saved == true) {
            is_job_saved = false;
            c_jobs_temp.splice(job_index,1);
            $('.saved-jobs-alert__check').toggleClass('removed');
            $('.saved-jobs-alert__message').html('Job has been removed.');
        }
        else {
            is_job_saved = true;
            c_jobs_temp.push('{{ job.external_id }}');
            $('.saved-jobs-alert__check').toggleClass('removed');
            $('.saved-jobs-alert__message').html('Job has been saved!');
        }

        localStorage.setItem('c_jobs', JSON.stringify(c_jobs_temp));
        
        $('.saved-jobs-alert-wrapper').fadeIn();
        setTimeout(function() {
            $('.button-saved').html('Saved');
            $('.saved-jobs-alert-wrapper').fadeOut();

            {% if request_fullpath contains '?savejob=1' %}
                {% capture savejob_params %}?savejob=1{% endcapture %}
            {% else %}
                {% capture savejob_params %}&savejob=1{% endcapture %}
            {% endif %}
            {% capture job_url_saved %}{{ request_fullpath | remove: savejob_params }}{% endcapture %}
            //location.reload();
            window.location.replace('{{ job_url_saved }}');
        }, 2000);
    {% endif %}
</script>
{% endcomment %}
      
{% page_required_footer %}