<input type="text" width="50" value="{{ post.url }}" id="post-share-url-js" tabindex="-1" style="left: -999px; position: fixed; top: -999px; z-index: -1;">
{% comment %}Copy to clipboard only works if the input is visible! If it needs to be hidden, position the input off-screen{% endcomment %}

{% for tag in post_object.tags %}
    {% if tag contains 'category-' and article_list_category == blank %}
        {% capture post_category %}{{ tag | remove_first: 'category-' | replace: '-',' ' }}{% endcapture %}
        {% capture post_category_tag %}{{ tag }}{% endcapture %}

        {% comment %}category tag mapping{% endcomment %}
        {% case tag %}
            {% when 'category-career-advice' %}
                {% capture post_category_color %}purple{% endcapture %}
            {% when 'category-employee-experiences' %}
                {% capture post_category_color %}orange{% endcapture %}
            {% when 'category-culture' %}
                {% capture post_category_color %}blue{% endcapture %}
        {% endcase %}

    {% elsif tag contains 'date-' %}
        {% comment %}For CWS Developer use only - used when we migrated their Blog Posts as we cannot capture the original post date{% endcomment %}
        {% capture pre_date_lower %}{{ tag | remove: 'date-' | replace: '-',' ' }}{% endcapture %}
        {% capture pre_date_first %}{{ pre_date_lower | slice: 0, 1 }}{% endcapture %}
        {% capture pre_date_first_upcase %}{{ pre_date_lower | slice: 0, 1 | upcase }}{% endcapture %}
        {% capture pre_date %}{{ pre_date_lower | replace_first: pre_date_first,pre_date_first_upcase }}{% endcapture %}

    {% endif %}
{% endfor %}

{% capture cb_post_category_link %}
 {% if post_category != blank %}<a href="/pages/{{ post_category_tag | remove_first: 'category-' }}" class="blog-post-item__category blog-post-item__category--{{ post_category_color }} {{ post_category_tag }} space-medium">{{ post_category }}</a>{% endif %}
 {% endcapture %}

 {% if cb_hero_author != blank %}
    {{ cb_hero_author | split: ', ' | assign_to: 'article_author_attrs' }}
    {% capture cb_article_author_name %}{{ article_author_attrs[0] }}{% endcapture %}
    {% capture cb_article_author_title %}{{ article_author_attrs[1] }}{% endcapture %}
{% else %}
    {% capture cb_article_author_name %}{{ post_object.creator.first_name }} {{ post_object.creator.last_name }}{% endcapture %}
    {% capture cb_article_author_title %}{{ post_object.creator.job_title }}{% endcapture %}
{% endif %}

{% capture cb_article_publish_data %}
<div class="article-publish-data">
    {% comment %}the cb_hero_author logic has been added to solve for the Author name - see _config__logic-page-hero{% endcomment %}
    <span>By {{ cb_article_author_name }}{% if cb_article_author_title != blank %}, {{ cb_article_author_title }}{% endif %}</span>
    <span>{{ post.content | strip_html | strip_newlines | split: " " | size | divided_by: 200 | ceil }} min read</span>
    <span>{% if pre_date != blank %}{{ pre_date }}{% else %}{{ post_object.created_at | date: '%B %Y' }}{% endif %}</span>

    <span class="article-publish-data__share" data-module="careers-share">
        <!-- <svg aria-hidden="true" focusable="false" preserveAspectRatio="xMinYMid meet" xmlns="http://www.w3.org/2000/svg" width="13.335" height="12.536" viewBox="0 0 13.335 12.536" tabindex="-1">  <path id="Path_83521" data-name="Path 83521" d="M10.912,7.925a2.17,2.17,0,0,0-1.9,1.106L4.339,7.065a2.1,2.1,0,0,0,0-1.72l4.73-1.966a2.17,2.17,0,0,0,1.9,1.106,2.2,2.2,0,0,0,2.211-2.212A2.308,2.308,0,0,0,10.912,0,2.2,2.2,0,0,0,8.7,2.212v.246L3.786,4.546a2.145,2.145,0,0,0-1.474-.614,2.212,2.212,0,0,0,0,4.423A2.145,2.145,0,0,0,3.786,7.74L8.762,9.829v.246a2.212,2.212,0,1,0,2.15-2.15Zm0-7a1.3,1.3,0,0,1,1.29,1.29,1.29,1.29,0,1,1-2.58,0A1.34,1.34,0,0,1,10.912.921ZM2.25,7.495A1.3,1.3,0,0,1,.96,6.2a1.34,1.34,0,0,1,1.29-1.29,1.29,1.29,0,0,1,0,2.58Zm8.662,3.932a1.3,1.3,0,0,1-1.29-1.29,1.29,1.29,0,1,1,2.58,0A1.3,1.3,0,0,1,10.912,11.426Z" transform="translate(0.025 0.125)" fill="inherit" stroke="inherit" stroke-width="0.25" tabindex="-1" focusable="false"></path></svg>
        &nbsp; -->
        Share:

        <div class="article-share-outer">
            <div class="cs_template_share cs_cfix">
                <div class="cs_share_container cs_cfix">
                    <span class="cs_share_email"></span>
                    
                </div>
            </div>
        </div>

        <a href="javascript:void(0);" id="article-publish-data__share--copy-js"><i class="fa-regular fa-copy"></i><span class="show-for-sr"> Copy link</span></a>
        <span class="article-publish-data__share--copied js">Link copied</span>
    </span>
</div>
<script type="text/javascript">talemetry.share();</script>
{% endcapture %}