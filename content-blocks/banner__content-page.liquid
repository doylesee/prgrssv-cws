<section id="banner-2" data-module="mma">    
    <div class="page-banner padded-v-medium">
        {% if page_section_object.images.size > 0 and page_section_object.permalink != cb_life_permalink %}
            <div class="hide-for-large">
                <img src="{{ page_section_object.images[0].url }}" alt="{% if page_section_object.images[0].title != page_section_object.images[0].file_name %}{{ page_section_object.images[0].title | html_safe }}{% endif %}" class="full-width" />
            </div>
        {% endif %}
        <div class="row">
            <div class="columns {{ cb_classes_column_wide }} padded-v-medium text-center">
                {{ page_section_object.content | assign_to: 'page_section_object_content' }}
                {% include '/_config__logic-page-hero' %}

                {% unless cb_page_hero contains 'h1' or cb_non_hero contains 'h1' %}
                <h1 id="main" tabindex="-1">{{ page_section_object.title | html_safe }}</h1>
                {% endunless %}

                {{ cb_page_hero }}
            </div>
        </div>
        {% if page_section_object.images.size > 0 %}
            <div class="row row--bigger show-for-large">
                <div class="columns">
                    {% if page_section_object.permalink == cb_life_permalink %}
                        {% if page_section_object.images.size > 1 %}
                        <img src="{{ page_section_object.images[1].url }}" alt="{% if page_section_object.images[1].title != page_section_object.images[1].file_name %}{{ page_section_object.images[1].title | html_safe }}{% endif %}" class="full-width" loading="lazy" />
                        {% endif %}
                    {% else %}
                        <img src="{{ page_section_object.images[0].url }}" alt="{% if page_section_object.images[0].title != page_section_object.images[0].file_name %}{{ page_section_object.images[0].title | html_safe }}{% endif %}" class="full-width" loading="lazy" />
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </div>
</section>