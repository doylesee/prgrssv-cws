{% include '/_config__variables' %}

{% capture life_cb_non_hero %}{{ cb_non_hero }}{% endcapture %}

{% if article_list_category != blank %}
    {{ article_list_category | posts_with_tag | assign_to: 'category_posts' }}
    {{ category_posts | reverse | assign_to: 'posts_object' }}
{% else %}
    {{ employer.posts | assign_to: 'posts_object' }}
{% endif %}

{% if article_list_category == blank %}
    <section class="background-2">
        <div class="row">
            <div class="column {{ cb_classes_column_wide }}">
                <div class="row same-height-parent-js" data-module="bricks">
                    {% for i in (1..employer.pages.size) %}
                        {% capture cb_life_child_tag_order %}life-at-category-{{ forloop.index }}{% endcapture %}
                        {{ cb_life_child_tag_order | pages_with_tag | assign_to: 'article_category_pages' }}

                        {% if article_category_pages.size > 0 %}
                            <div class="columns large-4 end space-foundation article-category-item-outer">
                                <a href="/pages/{{ article_category_pages[0].permalink }}" class="article-category-item">
                                    {% capture article_category_image %}
                                    {% if article_category_pages[0].images[0].url != blank %}
                                        <img src="{{ article_category_pages[0].images[0].url }}" alt="{% if article_category_pages[0].images[0].title != article_category_pages[0].images[0].file_name %}{{ article_category_pages[0].images[0].title | html_safe }}{% endif %}" class="full-width" loading="lazy" />
                                    {% else %}
                                        &nbsp;
                                    {% endif %}
                                    {% endcapture %}
                                    <div class="row">
                                        <div class="columns small-3 hide-for-large">
                                            {{ article_category_image }}
                                        </div>
                                        <div class="columns small-9 large-12">
                                            <div class="same-height-item-js">
                                                <div class="space-medium hide-for-large"></div>
                                                <h3>{{ article_category_pages[0].title | html_safe }}</h3>
                                            </div>
                                        </div>
                                        <div class="columns large-5 large-offset-7 show-for-large">
                                            {{ article_category_image }}
                                        </div>
                                    </div>
                                </a>
                            </div>
                        {% else %}
                            {% break %}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
        <div class="padded-v-large hide-for-large"></div>
    </section>
{% endif %}

<section {% if article_list_category == blank %}class="background-3"{% endif %}>
    <div class="row" style="max-width: 1300px;">
        <div class="column">
            <div class="background-white">
                <div class="article-list-outer padded-v-xlarge">
                        
                    {% if article_list_category == blank %}
                        {% if page_section_object.content != blank %}
                        <div class="row space-large">
                            <div class="column {{ cb_classes_column_narrow }}">
                                {{ page_section_object.content }}
                            </div>
                        </div>
                        {% endif %}

                        {{ 'featured-article' | posts_with_tag | reverse | assign_to: 'featured_articles' }}
                        {% if featured_articles.size > 0 %}
                            <div class="row space-large" data-module="image-list">
                                <div class="column {{ cb_classes_column_narrow }}">
                                    <div class="row">
                                        <div class="columns large-6 large-push-6 space-xlarge">
                                            {% if page.images.size > 0 %}
                                                <div class="article-list__featured-image">
                                                    <img src="{{ page.images[0].url }}" alt="{% if page.images[0].title != page.images[0].file_name %}{{ page.images[0].title | html_safe }}{% endif %}" loading="lazy" />
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="columns large-5 large-pull-7">
                                            <div class="article-list__featured-articles">
                                                <p class="branded-underline-1"><strong>FEATURED ARTICLES</strong></p>
                                                <h2><strong>Check out our unique approach to careers and growth</strong></h2>

                                                <div class="featured-blog-post-item-outer">
                                                    {% for post in featured_articles %}
                                                        <div class="blog-post-item padded-v-large" data-module="long-form-info">
                                                            {% for tag in post.tags %}
                                                                {% if tag contains 'category-' and article_list_category == blank %}
                                                                    {% capture post_category %}{{ tag | remove_first: 'category-' | replace: '-',' ' }}{% endcapture %}
                                                                    {% capture post_category_tag %}{{ tag }}{% endcapture %}

                                                                    {% comment %}category tag mapping{% endcomment %}
                                                                    {% case tag %}
                                                                        {% when 'category-career-advice' %}
                                                                            {% capture post_category_color %}purple{% endcapture %}
                                                                        {% when 'category-employee-experiences' %}
                                                                            {% capture post_category_color %}orange{% endcapture %}
                                                                        {% when 'category-culture' %}
                                                                            {% capture post_category_color %}blue{% endcapture %}
                                                                    {% endcase %}
                                                                {% endif %}
                                                            {% endfor %}

                                                            {% comment %}{{ post.created_at | date: '%B %-d %Y - %H:%M' }}<br />{% endcomment %}

                                                            {% if post_category != blank %}<a href="/pages/{{ post_category_tag | remove_first: 'category-' }}" class="blog-post-item__category blog-post-item__category--{{ post_category_color }} {{ post_category_tag }} space-medium">{{ post_category }}</a>{% endif %}

                                                            {{ post.content | assign_to: 'page_section_object_content' }}
                                                            {% include '/_config__logic-page-hero' %}
                                                            {% if cb_page_hero != blank %}
                                                                <h3 class="space-medium{% if item_index == 0 %} heading-1{% endif %}">
                                                                    <a href="/posts/{{ post.permalink }}">{{ cb_hero_heading }}</a>
                                                                </h3>
                                                            {% else %}
                                                                <h3 class="space-medium{% if item_index == 0 %} heading-1{% endif %}">
                                                                    {{ post | link_to_post }}
                                                                </h3>
                                                            {% endif %}

                                                            <p class="space-none">{{ post.content | strip_html | strip_newlines | split: " " | size | divided_by: 200 | ceil }} min read</p>
                                                        </div>
                                                    {% endfor %}
                                                </div>
                                            </div><!--close .article-list__featured-articles-->
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    {% endif %}

                    {% if life_cb_non_hero != blank %}
                        <div class="row space-large">
                            <div class="column {{ cb_classes_column_narrow }}">
                                {{ life_cb_non_hero }}
                            </div>
                        </div>
                    {% endif %}

                    <div class="blog-post-items">
                        {{ 0 | assign_to: 'item_counter' }}

                        {% for post in posts_object %}
                            {% capture post_category %}{% endcapture %}
                            {% capture post_category_tag %}{% endcapture %}

                            {% unless article_list_category == blank and post.tag_list contains 'featured-article' %}
                                {% unless post.tag_list contains '-section-' %}
                                    {{ item_counter | plus: 1 | assign_to: 'item_counter' }}

                                    <div class="row blog-post-item-outer" data-module="swiss-image">
                                        <div class="column {{ cb_classes_column_wide }}">
                                            <div class="blog-post-item padded-v-large">
                                                {% if article_list_category != blank %}
                                                    {{ item_counter | modulo: 4 | assign_to: 'item_index' }}
                                                {% else %}
                                                    {{ item_counter | modulo: 5 | assign_to: 'item_index' }}
                                                {% endif %}

                                                <div class="row">
                                                    <div class="column large-10 large-offset-1 end">
                                                        <div class="row">
                                                            {% if item_index != 0 %}
                                                                {% if post.images.size > 0 %}
                                                                    <div class="columns large-5">
                                                                        <div class="blog-post-item__image">
                                                                            <img src="{{ post.images[0].url }}" alt="{% if post.images[0].title != post.images[0].file_name %}{{ post.images[0].title | html_safe }}{% endif %}" class="full-width space-medium" loading="lazy" />
                                                                        </div>
                                                                    </div>
                                                                {% endif %}
                                                            {% endif %}
                                                            <div class="columns{% if item_index != 0 %}{% if post.images.size > 0 %} large-6 large-offset-1{% endif %}{% endif %}" data-module="long-form-info">
                                                                {% for tag in post.tags %}
                                                                    {% if tag contains 'category-' and article_list_category == blank %}
                                                                        {% capture post_category %}{{ tag | remove_first: 'category-' | replace: '-',' ' }}{% endcapture %}
                                                                        {% capture post_category_tag %}{{ tag }}{% endcapture %}

                                                                        {% comment %}category tag mapping{% endcomment %}
                                                                        {% case tag %}
                                                                            {% when 'category-career-advice' %}
                                                                                {% capture post_category_color %}purple{% endcapture %}
                                                                            {% when 'category-employee-experiences' %}
                                                                                {% capture post_category_color %}orange{% endcapture %}
                                                                            {% when 'category-culture' %}
                                                                                {% capture post_category_color %}blue{% endcapture %}
                                                                        {% endcase %}
                                                                    {% endif %}
                                                                {% endfor %}

                                                                {% comment %}{{ post.created_at | date: '%B %-d %Y - %H:%M' }}<br />{% endcomment %}

                                                                {% if post_category != blank %}<a href="/pages/{{ post_category_tag | remove_first: 'category-' }}" class="blog-post-item__category blog-post-item__category--{{ post_category_color }} {{ post_category_tag }} space-medium">{{ post_category }}</a>{% endif %}

                                                                {{ post.content | assign_to: 'page_section_object_content' }}
                                                                {% include '/_config__logic-page-hero' %}
                                                                {% if cb_page_hero != blank %}
                                                                    <h3 class="space-medium{% if item_index == 0 %} heading-1{% endif %}">
                                                                        <a href="/posts/{{ post.permalink }}">{{ cb_hero_heading }}</a>
                                                                    </h3>
                                                                {% else %}
                                                                    <h3 class="space-medium{% if item_index == 0 %} heading-1{% endif %}">
                                                                        {{ post | link_to_post }}
                                                                    </h3>
                                                                {% endif %}

                                                                {% if article_list_category != blank %}
                                                                    <div class="blog-post">{{ cb_hero_body }}</div>
                                                                {% endif %}

                                                                <p class="space-none">{{ post.content | strip_html | strip_newlines | split: " " | size | divided_by: 200 | ceil }} min read</p>
                                                            </div>
                                                        </div>
                                                    </div><!--close .column narrow-->
                                                </div>
                                            </div><!--close .blog-post-item-->
                                        </div><!--close .column wide-->
                                    </div><!--close .blog-post-item-outer-->
                                {% endunless %}
                            {% endunless %}
                        {% endfor %}
                    </div><!--close .blog-post-items-->

                </div><!--close .article-list-outer-->
            </div><!--close .background-->
        </div><!--close .column-->
    </div><!--close .row-->
</section>

{% if article_list_category != blank %}
<!--CultureHQ videos-->
<section>
    <div class="row">
        <div class="column {{ cb_classes_column_narrow }}">
            <div id="chq_1722613419009" /><script type="text/javascript">+function (c, h, q, z, y) { (y = document.createElement("script")).type = "text/javascript"; y.src = "https://assets.culturehq.com/widget_1689030416.js"; y.onload = function () { CHQ(c, h, q, z) }; document.getElementsByTagName("head")[0].appendChild(y); }("#chq_1722613419009", "null", {"i":[27577],"co":[],"d":[],"l":[],"s":[],"cl":[],"cy":[],"p":[],"de":[],"v":[],"u":[],"sp":[],"t":[],"org":122})</script>
        </div>
    </div>
</section>
{% endif %}

{% comment %}
<style>
.body-inner { position: relative; }
.marker-1,
.marker-2 {
    height: 1px;
    left: 0;
    position: absolute;
    width: 100%;
    z-index: 99999;
}
.marker-1 { background: #ff0000; }
.marker-2 { background: #00ff00; }
</style>
{% endcomment %}

{% if page.images.size > 0 %}
<script>
$(document).ready(function() {
    var list_bottom = 0;
    var list_end = 0;

    $(window).resize(function() {
        $('.article-list__featured-image').attr('style','top: 0;');

        if ($('.width-detector').width() >= 1024) {
            setTimeout(function() {
                // On resize, bottom of featured list
                list_bottom = $('.article-list__featured-articles').offset().top + $('.article-list__featured-articles').outerHeight() - 150;
                list_end = list_bottom - ($('.article-list__featured-image').outerHeight() / 2);

                /*
                $('.marker-1').attr('style','top: '+list_bottom+'px;');
                $('.marker-2').attr('style','top: '+list_end+'px;');
                */
            }, 500);
        }
        else {
            list_bottom = 0;
            list_end = 0;
        }
    }).resize();

    $(window).scroll(function() {
        if (list_end != 0) {
            if ($(window).scrollTop() < list_end) {
                var slow_element = $('.article-list__featured-image');
                var y_position = 0 + window.pageYOffset/5;
                slow_element.attr('style','top:'+y_position+'px;');
            }
        }
    });
});
</script>
{% endif %}